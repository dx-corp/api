{
  "schemaVersion": 1,
  "service": "deixicpublic.v1.DeixicPublicService",
  "packages": {
    "typescript": "@evalops/deixic-sdk",
    "python": "deixic-sdk",
    "go": "github.com/dx-corp/deixic-go"
  },
  "scope": {
    "constructorBound": true,
    "requestHeaders": [
      "X-Organization-ID",
      "X-Workspace-ID"
    ],
    "requestMessage": true
  },
  "authenticationReplay": {
    "maximumAttempts": 1,
    "requiresStableIdentity": true,
    "reusesRequestBytes": true
  },
  "operations": [
    {
      "rpc": "GetThread",
      "facade": "threads.get",
      "kind": "query"
    },
    {
      "rpc": "ListEvents",
      "facade": "events.list",
      "kind": "query"
    },
    {
      "rpc": "WatchEvents",
      "facade": "events.watch",
      "kind": "server-stream",
      "callerOwnsReconnect": true
    },
    {
      "rpc": "SubmitTask",
      "facade": "messages.send",
      "kind": "mutation",
      "requiresIdempotencyKey": true,
      "acceptedIsTerminal": false
    },
    {
      "rpc": "InterruptTask",
      "facade": "controls.interrupt",
      "kind": "mutation",
      "requiresIdempotencyKey": true
    },
    {
      "rpc": "RespondToRequest",
      "facade": "controls.respond",
      "kind": "mutation",
      "requiresIdempotencyKey": true
    },
    {
      "rpc": "GetReceipt",
      "facade": "receipts.get",
      "kind": "query"
    },
    {
      "rpc": "ResolveReceiptAction",
      "facade": "receipts.resolve",
      "kind": "mutation",
      "requiresIdempotencyKey": true
    }
  ]
}
